{
  "version": 2,
  "functions": {
    "api/translate.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/external.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/mega.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/drive.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/witanime.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/anime3rb.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/serve.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/extractor.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/download.js": {
